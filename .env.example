DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/college_social
REDIS_URL=redis://localhost:6379
CURSOR_SECRET_KEY=
SECRET_KEY=
DB_ECHO=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Post submission limits
MAX_TITLE_LENGTH=255
MAX_BODY_LENGTH=5000
MAX_MEDIA_COUNT=10
MAX_MEDIA_SIZE=10485760

# Profile limits
MAX_USERNAME_LENGTH=100
MAX_ABOUT_LENGTH=2000
MAX_SKILLS=50
MAX_PROFILE_ITEMS=25

# Media folders (all nested under MEDIA_BASE_DIR)
MEDIA_BASE_DIR=nexus_media
POST_MEDIA_DIR=posts
DELETED_POST_MEDIA_DIR=deleted_posts
PROFILE_MEDIA_DIR=profiles
OTHER_MEDIA_DIR=other

# Largest id list any /batch endpoint accepts
MAX_BATCH_SIZE=15
